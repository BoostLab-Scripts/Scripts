local noclipEnabled = false
local noclipConnection
local noclipDescendantConnection
local noclipSavedCollision = setmetatable({}, { __mode = "k" })

-- Noclip only removes collision from the local character. World/building parts remain
-- visually unchanged, so walls do not become transparent or disappear; you simply pass through them.
local function setCharacterCollision(enabled)
	local char = LocalPlayer.Character
	if not char then return end

	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			if enabled then
				local old = noclipSavedCollision[part]
				part.CanCollide = old ~= nil and old or true
				if old ~= nil then noclipSavedCollision[part] = nil end
			else
				if noclipSavedCollision[part] == nil then
					noclipSavedCollision[part] = part.CanCollide
				end
				part.CanCollide = false
			end
		end
	end
end

local function startNoclip()
	if noclipConnection then noclipConnection:Disconnect() end
	if noclipDescendantConnection then noclipDescendantConnection:Disconnect() end

	local char = LocalPlayer.Character
	if char then
		noclipDescendantConnection = char.DescendantAdded:Connect(function(obj)
			if noclipEnabled and obj:IsA("BasePart") then
				if noclipSavedCollision[obj] == nil then
					noclipSavedCollision[obj] = obj.CanCollide
				end
				obj.CanCollide = false
			end
		end)
	end

	-- Stepped is intentionally used so character collision is restored/disabled before physics resolves.
	noclipConnection = RunService.Stepped:Connect(function()
		if not noclipEnabled then return end
		setCharacterCollision(false)
	end)

	setCharacterCollision(false)
end

local function stopNoclip()
	if noclipConnection then noclipConnection:Disconnect(); noclipConnection = nil end
	if noclipDescendantConnection then noclipDescendantConnection:Disconnect(); noclipDescendantConnection = nil end

	local char = LocalPlayer.Character
	if char then
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				local old = noclipSavedCollision[part]
				if old ~= nil then
					part.CanCollide = old
					noclipSavedCollision[part] = nil
				end
			end
		end
	end
end

