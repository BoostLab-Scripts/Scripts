local function unloadBoostLab()
	if not boostLabActive then return end
	boostLabActive = false
	-- Stop our own connections/features.
	pcall(function() stopFly() end)
	pcall(function() stopNoclip() end)
	pcall(function() disconnectInfiniteJumpConnections() end)
	table.clear(noclipSavedCollision)
	pcall(function() disconnectModeratorProtection() end)
	pcall(function() restoreUltimate() end)
	ultimateStartedFPSBooster = false
	pcall(function() disableFPSBooster() end)
	pcall(function() if recoilConnection then recoilConnection:Disconnect(); recoilConnection = nil end end)
	pcall(function() restoreWeaponPatches() end)
	pcall(function() for _, c in ipairs(weaponWatchConnections) do c:Disconnect() end table.clear(weaponWatchConnections) end)
	pcall(function()
        for _, c in ipairs(buildWatcherConnections) do c:Disconnect() end
        table.clear(buildWatcherConnections)
    end)
    pcall(function() buildRestoreAll() end)
	pcall(function() if fpsGui then fpsGui:Destroy() end end)

	-- Hide ESP objects.
	for player in pairs(espObjects) do
		pcall(function() destroyESPFor(player) end)
	end

	-- Hide FOV.
	pcall(function() fovCircle.Visible = false end)

	-- Disconnect every connection we created where references are available.
	pcall(function()
		if antiAfkConnection then
			antiAfkConnection:Disconnect()
			antiAfkConnection = nil
		end
	end)

	-- Destroy the Rayfield GUI.
	pcall(function()
		if Window then
			Rayfield:Destroy()
		end
	end)

	-- Mark the feature as fully unloaded; active loops return immediately.
	_G.BoostLabUnloaded = true

	-- Remove any remaining BoostLab ScreenGui instances.
	local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if playerGui then
		for _, gui in ipairs(playerGui:GetChildren()) do
			if gui.Name == "BoostLab" or gui.Name == "BoostLabIntro" then
				pcall(function() gui:Destroy() end)
