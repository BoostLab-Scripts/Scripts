-- Local/client-side compatibility layer for Tool-based weapons.
-- This does not bypass server-side weapon validation.

local noRecoilEnabled = false
local noReloadEnabled = false
local recoilStrength = 100
local recoilConnection = nil
local weaponPatches = {}
local weaponWatchConnections = {}
local lastCameraCFrame = nil
local lastCameraPosition = nil

local RECOIL_NAMES = {
	recoil=true, recoilstrength=true, recoil_strength=true,
	recoilamount=true, recoil_amount=true, camerarecoil=true,
	camera_recoil=true, camerakick=true, camera_kick=true,
	kick=true, kickamount=true, kick_amount=true,
	verticalrecoil=true, vertical_recoil=true, horizontalrecoil=true,
	horizontal_recoil=true,
}

local RELOAD_NAMES = {
	reloadtime=true, reload_time=true, reloadspeed=true, reload_speed=true,
	reloadcooldown=true, reload_cooldown=true, reloadinterval=true, reload_interval=true,
	reloadlength=true, reload_length=true, rechargetime=true, recharge_time=true,
}

local AMMO_NAMES = {
	ammo=true, currentammo=true, current_ammo=true, magazineammo=true,
	magazine_ammo=true, clipammo=true, clip_ammo=true, bullets=true,
}

local function normalizedName(name)
	return string.lower(tostring(name or "")):gsub("[%s%-]", "_")
end

local function getEquippedTool()
	local char = LocalPlayer.Character
	if not char then return nil end
	for _, obj in ipairs(char:GetChildren()) do
		if obj:IsA("Tool") then return obj end
	end
	return nil
end

local function rememberPatch(obj, key, value)
	weaponPatches[obj] = weaponPatches[obj] or {}
	if weaponPatches[obj][key] == nil then
		weaponPatches[obj][key] = value
	end
end

local function patchNumberObject(obj)
	if not obj:IsA("NumberValue") and not obj:IsA("IntValue") then return end
	local name = normalizedName(obj.Name)


	if noRecoilEnabled and RECOIL_NAMES[name] then
		rememberPatch(obj, "Value", obj.Value)
		obj.Value = obj.Value * (1 - math.clamp(recoilStrength / 100, 0, 1))
	end

	if noReloadEnabled and RELOAD_NAMES[name] then
		rememberPatch(obj, "Value", obj.Value)
		obj.Value = 0
	end

	if noReloadEnabled and AMMO_NAMES[name] then
		rememberPatch(obj, "Value", obj.Value)
		if obj.Value < 999 then obj.Value = 999 end
	end
end

local function patchAttributes(tool)
	for attrName, value in pairs(tool:GetAttributes()) do
		if typeof(value) ~= "number" then continue end
		local name = normalizedName(attrName)

		if noRecoilEnabled and RECOIL_NAMES[name] then
			rememberPatch(tool, "Attribute:" .. attrName, value)
			tool:SetAttribute(attrName, value * (1 - math.clamp(recoilStrength / 100, 0, 1)))
		elseif noReloadEnabled and RELOAD_NAMES[name] then
			rememberPatch(tool, "Attribute:" .. attrName, value)
			tool:SetAttribute(attrName, 0)
		elseif noReloadEnabled and AMMO_NAMES[name] then
			rememberPatch(tool, "Attribute:" .. attrName, value)
			tool:SetAttribute(attrName, math.max(value, 999))
		end
	end
end

local function patchCurrentTool()
	local tool = getEquippedTool()
	if not tool then return end

	for _, obj in ipairs(tool:GetDescendants()) do
		patchNumberObject(obj)
	end
	patchAttributes(tool)
end

local function restoreWeaponPatches()
	for obj, props in pairs(weaponPatches) do
		if obj and obj.Parent then
			for key, oldValue in pairs(props) do
				pcall(function()
					if key:sub(1, 10) == "Attribute:" then
						obj:SetAttribute(key:sub(11), oldValue)
					else
						obj[key] = oldValue
					end
				end)
			end
		end
	end
	table.clear(weaponPatches)
end

local function refreshWeaponPatches()
	restoreWeaponPatches()
	patchCurrentTool()
end


local function stopRecoilStabilizer()
	if recoilConnection then
		recoilConnection:Disconnect()
		recoilConnection = nil
	end
	pcall(function() RunService:UnbindFromRenderStep("BoostLabNoRecoil") end)
	lastCameraCFrame = nil
	lastCameraPosition = nil
end

local function startRecoilStabilizer()
	stopRecoilStabilizer()
	if not noRecoilEnabled then return end

	local last = workspace.CurrentCamera and workspace.CurrentCamera.CFrame or nil
	local lastMouse = Vector2.zero
	local residualPitch = 0
	local residualYaw = 0

	RunService:BindToRenderStep("BoostLabNoRecoil", Enum.RenderPriority.Camera.Value + 20, function()
		if not noRecoilEnabled then return end
		local camera = workspace.CurrentCamera
		if not camera then return end
		Camera = camera

		local current = camera.CFrame
		if not last then
			last = current
			return
		end

		local rel = last:ToObjectSpace(current)
		local pitch, yaw, roll = rel:ToOrientation()
		local mouse = UserInputService:GetMouseDelta()

		-- Learn the normal camera response to mouse movement. Recoil usually appears
		-- as rotational movement that is not explained by the current mouse input.
		local explainedPitch = -mouse.Y * 0.0025
		local explainedYaw = -mouse.X * 0.0025
		local residualP = pitch - explainedPitch
		local residualY = yaw - explainedYaw

		-- Ignore tiny normal camera noise, but catch both recoil kicks and sustained recoil.
		if math.abs(residualP) > math.rad(0.08) or math.abs(residualY) > math.rad(0.08) then
			local factor = math.clamp(recoilStrength / 100, 0, 1)
			local correctionP = math.clamp(residualP * factor, -math.rad(8), math.rad(8))
			local correctionY = math.clamp(residualY * factor, -math.rad(8), math.rad(8))
			camera.CFrame = current * CFrame.Angles(-correctionP, -correctionY, -roll * factor)
			current = camera.CFrame
		end

		last = current
		lastMouse = mouse
	end)
end

-- Refresh whenever the player equips/unequips a Tool or a weapon config changes.
local function watchCharacter(char)
	for _, c in ipairs(weaponWatchConnections) do pcall(function() c:Disconnect() end) end
	table.clear(weaponWatchConnections)

	local function watchTool(tool)
		if not tool:IsA("Tool") then return end
		-- Weapon watcher used only for No Recoil / No Reload patch refresh.
	end

	for _, obj in ipairs(char:GetChildren()) do
		if obj:IsA("Tool") then watchTool(obj) end
	end

	table.insert(weaponWatchConnections, char.ChildAdded:Connect(function(obj)
		if obj:IsA("Tool") then
			task.wait()
			watchTool(obj)
			if noRecoilEnabled or noReloadEnabled then refreshWeaponPatches() end
		end
	end))

	table.insert(weaponWatchConnections, char.ChildRemoved:Connect(function(obj)
		if obj:IsA("Tool") then
			if noRecoilEnabled or noReloadEnabled then refreshWeaponPatches() end
		end
	end))
end

if LocalPlayer.Character then watchCharacter(LocalPlayer.Character) end


LocalPlayer.CharacterAdded:Connect(function(char)
	stopRecoilStabilizer()
	task.wait(0.2)
	watchCharacter(char)
	if noRecoilEnabled or noReloadEnabled then
		refreshWeaponPatches()
		startRecoilStabilizer()
	end
end)

