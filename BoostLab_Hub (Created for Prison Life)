-- BUILDS TAB
-- Optimized local build visibility controls.
-- Work is processed in small batches to avoid freezing/lag spikes.
BuildsTab:CreateParagraph({
    Title = "Build Controls",
    Content = "Hide selected world-build categories locally. Changes are processed in batches to reduce lag and are fully reversible.",
})

local buildStates = {
    Doors = false,
    Gates = false,
    Walls = false,
    Windows = false,
    Fences = false,
    Barriers = false,
    Roofs = false,
    Props = false,
}

local buildSaved = setmetatable({}, { __mode = "k" })
local buildWatcherConnections = {}
local buildQueue = {}
local buildQueued = setmetatable({}, { __mode = "k" })
local buildScanToken = 0

local BUILD_PATTERNS = {
    Doors = {"door", "doorframe", "doorway"},
    Gates = {"gate", "gatehouse", "barriergate"},
    Walls = {"wall", "wallsegment", "brickwall", "concretewall", "stonewall"},
    Windows = {"window", "windowframe", "glasswindow"},
    Fences = {"fence", "railing", "bannister"},
    Barriers = {"barrier", "barricade", "roadblock", "roadblocker"},
    Roofs = {"roof", "ceiling"},
    Props = {"prop", "decoration", "decor"},
}

local BUILD_CATEGORY_ORDER = {"Doors", "Gates", "Walls", "Windows", "Fences", "Barriers", "Roofs", "Props"}

local function buildNormalize(text)
    return tostring(text or ""):lower():gsub("[%s%p_%-]+", "")
end

local buildCategoryCache = setmetatable({}, { __mode = "k" })
local function buildCategoryFor(obj)
    if not obj then return nil end
    local cached = buildCategoryCache[obj]
    if cached ~= nil then return cached or nil end

    local current = obj
    for _ = 1, 4 do
        if not current then break end
        local name = buildNormalize(current.Name)
        for _, category in ipairs(BUILD_CATEGORY_ORDER) do
            for _, pattern in ipairs(BUILD_PATTERNS[category]) do
                local p = buildNormalize(pattern)
                if name == p or name:find(p, 1, true) then
                    buildCategoryCache[obj] = category
                    return category
                end
            end
        end
        current = current.Parent
    end

    buildCategoryCache[obj] = false
    return nil
end

local function buildIsProtected(obj)
    if not obj then return true end
    if LocalPlayer.Character and obj:IsDescendantOf(LocalPlayer.Character) then return true end
    if workspace.CurrentCamera and obj:IsDescendantOf(workspace.CurrentCamera) then return true end
    local n = buildNormalize(obj.Name)
    return n:find("boostlabkeep", 1, true) ~= nil or n:find("noremove", 1, true) ~= nil
end

local function buildSaveOriginal(obj)
    if buildSaved[obj] ~= nil or not obj:IsA("BasePart") or buildIsProtected(obj) then return end
    buildSaved[obj] = {
        LocalTransparencyModifier = obj.LocalTransparencyModifier,
        CanCollide = obj.CanCollide,
        CanTouch = obj.CanTouch,
        CanQuery = obj.CanQuery,
    }
end

local function buildApplyPart(obj, hidden)
    if not obj:IsA("BasePart") or buildIsProtected(obj) then return end
    if hidden then
        buildSaveOriginal(obj)
        obj.LocalTransparencyModifier = 1
        obj.CanCollide = false
        obj.CanTouch = false
        obj.CanQuery = false
    else
        local original = buildSaved[obj]
        if original then
            obj.LocalTransparencyModifier = original.LocalTransparencyModifier
            obj.CanCollide = original.CanCollide
            obj.CanTouch = original.CanTouch
            obj.CanQuery = original.CanQuery
            buildSaved[obj] = nil
        end
    end
end

local function queueBuildObject(obj)
    if not obj or not obj.Parent or buildQueued[obj] then return end
    buildQueued[obj] = true
    buildQueue[#buildQueue + 1] = obj
end

local function clearBuildQueue()
    table.clear(buildQueue)
    table.clear(buildQueued)
end

-- Small-batch worker: prevents a full GetDescendants pass from blocking frames.
task.spawn(function()
    while boostLabActive do
        local processed = 0
        while processed < 80 and #buildQueue > 0 do
            local obj = table.remove(buildQueue, 1)
            buildQueued[obj] = nil
            if obj and obj.Parent and boostLabActive then
                local category = buildCategoryFor(obj)
                if category and buildStates[category] then
                    buildApplyPart(obj, true)
                end
            end
            processed += 1
        end
        task.wait()
    end
end)

local function buildQueueWorldScan()
    buildScanToken += 1
    local token = buildScanToken
    clearBuildQueue()
    local descendants = workspace:GetDescendants()
    task.spawn(function()
        for i, obj in ipairs(descendants) do
            if token ~= buildScanToken or not boostLabActive then return end
            queueBuildObject(obj)
            if i % 250 == 0 then task.wait() end
        end
    end)
end

local function buildRestoreCategory(category)
    for obj, original in pairs(buildSaved) do
        if obj and obj.Parent and buildCategoryFor(obj) == category then
            buildApplyPart(obj, false)
        end
    end
end

local function buildRestoreAll()
    buildScanToken += 1
    clearBuildQueue()
    for obj, original in pairs(buildSaved) do
        if obj and obj.Parent then
            pcall(function()
                obj.LocalTransparencyModifier = original.LocalTransparencyModifier
                obj.CanCollide = original.CanCollide
                obj.CanTouch = original.CanTouch
                obj.CanQuery = original.CanQuery
            end)
        end
        buildSaved[obj] = nil
    end
end

for _, connection in ipairs(buildWatcherConnections) do
    pcall(function() connection:Disconnect() end)
end
table.clear(buildWatcherConnections)

table.insert(buildWatcherConnections, workspace.DescendantAdded:Connect(function(obj)
    if boostLabActive then queueBuildObject(obj) end
end))

table.insert(buildWatcherConnections, workspace.DescendantRemoving:Connect(function(obj)
    buildSaved[obj] = nil
    buildQueued[obj] = nil
end))

local function setBuildCategory(category, enabled)
    buildStates[category] = enabled
    if enabled then
        buildQueueWorldScan()
        Rayfield:Notify({
            Title = category .. " Enabled",
            Content = "Processing matching objects in small batches.",
            Duration = 2,
        })
    else
        buildRestoreCategory(category)
        Rayfield:Notify({
            Title = category .. " Disabled",
            Content = "Original local values restored.",
            Duration = 2,
        })
    end
end

for _, category in ipairs(BUILD_CATEGORY_ORDER) do
    BuildsTab:CreateToggle({
        Name = "Hide " .. category,
        CurrentValue = false,
        Flag = "BuildHide" .. category,
        Callback = function(value)
            setBuildCategory(category, value)
        end,
    })
end

