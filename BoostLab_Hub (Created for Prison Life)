-- Moderator Protection:
-- Optional local safeguard for games where staff accounts can be identified
-- by configurable name prefixes / attributes. The callback only leaves the
-- current client; it does not attempt to interfere with other players.
local moderatorProtection = false
local moderatorConnections = {}
local moderatorLeaveInProgress = false

local MODERATOR_NAME_PATTERNS = {
    "mod", "moderator", "admin", "administrator", "staff", "developer", "dev", "owner"
}

local function disconnectModeratorProtection()
    for _, connection in ipairs(moderatorConnections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(moderatorConnections)
end

local function isModeratorPlayer(player)
    if not player or player == LocalPlayer then return false end

    -- Explicit attributes take priority when a game exposes them.
    local ok, values = pcall(function()
        return {
            player:GetAttribute("IsModerator"),
            player:GetAttribute("IsAdmin"),
            player:GetAttribute("IsStaff"),
            player:GetAttribute("Moderator"),
            player:GetAttribute("Admin"),
            player:GetAttribute("Staff")
        }
    end)
    if ok then
        for _, value in ipairs(values) do
            if value == true then return true end
        end
    end

    local lowerName = string.lower(player.Name .. " " .. (player.DisplayName or ""))
    for _, pattern in ipairs(MODERATOR_NAME_PATTERNS) do
        if lowerName:find(pattern, 1, true) then
            return true
        end
    end

    return false
end

local function leaveBecauseModerator(player)
    if moderatorLeaveInProgress then return end
    moderatorLeaveInProgress = true
    Rayfield:Notify({
        Title = "Moderator Protection",
        Content = "Staff account detected: " .. tostring(player.DisplayName or player.Name),
        Duration = 1,
    })
    task.delay(0.2, function()
        pcall(function()
            game:GetService("TeleportService"):Teleport(game.PlaceId, LocalPlayer)
        end)
    end)
end

local function scanForModerators()
    if not moderatorProtection or moderatorLeaveInProgress then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if isModeratorPlayer(player) then
            leaveBecauseModerator(player)
            return
        end
    end
end

local function applyModeratorProtection()
    disconnectModeratorProtection()
    scanForModerators()

    table.insert(moderatorConnections, Players.PlayerAdded:Connect(function(player)
        task.defer(function()
            if moderatorProtection and isModeratorPlayer(player) then
                leaveBecauseModerator(player)
            end
        end)
    end))

    table.insert(moderatorConnections, Players.PlayerRemoving:Connect(function()
        task.defer(scanForModerators)
    end))

    table.insert(moderatorConnections, RunService.Heartbeat:Connect(function()
        scanForModerators()
    end))
end

