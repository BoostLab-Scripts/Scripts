local VISUAL_TEAM_CHECK_ENABLED = true
local COMBAT_TEAM_CHECK_ENABLED = true

local function isSameTeam(player)
	if not player or player == LocalPlayer then return false end

	-- Prefer the actual Team instance.
	if LocalPlayer.Team ~= nil and player.Team ~= nil then
		return LocalPlayer.Team == player.Team
	end

	-- Fallback for games that only assign TeamColor.
	if LocalPlayer.TeamColor ~= nil and player.TeamColor ~= nil then
		return LocalPlayer.TeamColor == player.TeamColor
	end

	return false
end

local function shouldHideVisualTarget(player)
	return VISUAL_TEAM_CHECK_ENABLED and isSameTeam(player)
end

local function shouldSkipCombatTarget(player)
	return COMBAT_TEAM_CHECK_ENABLED and isSameTeam(player)
end

