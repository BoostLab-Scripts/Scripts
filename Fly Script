	bgGradient.Parent = root

	local glow = Instance.new("Frame")
	glow.AnchorPoint = Vector2.new(0.5, 0.5)
	glow.Position = UDim2.fromScale(0.5, 0.43)
	glow.Size = UDim2.fromScale(0.18, 0.18)
